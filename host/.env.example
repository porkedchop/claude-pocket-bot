# Briefbot host config.
#
# Two ways to provide keys:
#
# 1) Copy this file to host/.env (gitignored) and fill in. Source it
#    before running:    set -a; source .env; set +a
#
# 2) Skip host/.env entirely. The host script auto-loads keys from
#    ~/accountbriefbot/.env if it exists, so if you already keep keys
#    there you don't need to duplicate them.
#
# host/.env wins on conflict — use it for per-demo overrides.

# Required for Whisper transcription on the laptop.
OPENAI_API_KEY=sk-proj-...

# Required for live brief generation (Brave search + Claude synthesis).
# Comma-separated; the host rotates keys on 429.
BRAVE_API_KEYS=BSAk...,BSAJ...

# Required for the Claude Haiku synthesis step. Without this we fall
# back to the device's bundled fixtures.
ANTHROPIC_API_KEY=sk-ant-...
